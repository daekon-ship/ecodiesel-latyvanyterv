# ============================================================
# DIESEL MOTOR JAVÍTÁS — dieselmotorjavitas.hu
# Production Apache/LiteSpeed konfiguráció (statikus oldal)
# ============================================================

# ---- HSTS (2026-10-05: SSL-tanúsítvány javítva, Let's Encrypt wildcard) ----
# Védelem a https://dieselmotorjavitas.hu és https://www.dieselmotorjavitas.hu látogatásokra.
# SZÁNDEKOSAN includeSubDomains NÉLKÜL: a mail/webmail/wepanel aldomaineket a
# tárhelyszolgáltató menedzseli és korábban már volt hibás a certjük — egy
# böngészőbe gyorsított HSTS nem fordítható vissza gyorsan, nem kockáztatjuk
# a webmail/panel hozzáférés kitiltását.
Header always set Strict-Transport-Security "max-age=31536000"

# ---- Biztonsági headerek ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ---- Karakterkódolás ----
AddDefaultCharset UTF-8

# ---- MIME-típusok (a fenti X-Content-Type-Options: nosniff miatt kötelező:
#      rossz tartalomtípus esetén a böngésző/Google letiltaná a fájlt) ----
AddType image/vnd.microsoft.icon .ico
AddType image/svg+xml .svg
AddType image/png .png
AddType application/manifest+json .webmanifest

# ---- Tömörítés ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Cache (konzervatív, cache-busting query nélküli oldalhoz) ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 days"
  ExpiresByType application/javascript "access plus 1 days"
  # Favicon: szándékosan rövid cache, hogy egy ikonfrissítés mielőbb látszódjon
  ExpiresByType image/vnd.microsoft.icon "access plus 1 days"
  ExpiresByType application/manifest+json "access plus 1 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
</IfModule>
